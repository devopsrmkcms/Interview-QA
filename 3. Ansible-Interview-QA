55. How ansible collection is created and its file structure ?

# Create collection directory structure
ansible-galaxy collection init my_namespace.my_collection

my_namespace/
  my_collection/
    galaxy.yml           # Collection metadata
    README.md
    roles/               # Directory for roles
    modules/             # Directory for custom modules
    plugins/             # Directory for plugins

cd my_namespace/my_collection/

# Build the collection tarball
ansible-galaxy collection build

# Install from the tarball
ansible-galaxy collection install my_namespace-my_collection-1.0.0.tar.gz

# Or install from current directory
ansible-galaxy collection install .

ansible-galaxy collection list
